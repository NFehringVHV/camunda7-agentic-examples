<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.8</version>
        <relativePath/>
    </parent>

    <groupId>io.github.camunda7-agentic</groupId>
    <artifactId>example-worker</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>example-worker</name>
    <description>Runnable agentic worker wired to AWS Bedrock (Spring AI Converse) - "bring your own
        provider" for the camunda7-agentic-starter.</description>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring-ai.version>2.0.1</spring-ai.version>
        <camunda7-agentic.version>0.1.0-SNAPSHOT</camunda7-agentic.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- The vendor-neutral agentic starter (workers + auto-configuration). -->
        <dependency>
            <groupId>io.github.camunda7-agentic</groupId>
            <artifactId>camunda7-agentic-starter</artifactId>
            <version>${camunda7-agentic.version}</version>
        </dependency>

        <!-- Concrete LLM provider: AWS Bedrock via Spring AI Converse.
             This auto-configures a ChatModel bean the starter consumes - no code needed. -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-bedrock-converse</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
